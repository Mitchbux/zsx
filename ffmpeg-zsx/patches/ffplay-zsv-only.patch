+static int zsv_validate_profile(AVFormatContext *ic)
+{
+    static const uint8_t dct_prefix[]  = { 'Z', 'S', 'X', 'D', 1,
+                                            AV_PIX_FMT_YUV420P };
+    static const uint8_t mdct_prefix[] = { 'Z', 'S', 'X', 'M', 2,
+                                            AV_SAMPLE_FMT_FLT };
+    const AVDictionaryEntry *profile = NULL;
+    int profile_entries = 0, video_entries = 0, audio_entries = 0;
+    unsigned int i;
+
+    if (!ic->iformat || strcmp(ic->iformat->name, "nut")) {
+        av_log(NULL, AV_LOG_ERROR, "Rejected: input is not a NUT container.\n");
+        return AVERROR_INVALIDDATA;
+    }
+    while ((profile = av_dict_get(ic->metadata, "zsv_profile", profile,
+                                  AV_DICT_MATCH_CASE))) {
+        profile_entries++;
+        if (strcmp(profile->value, "2")) {
+            av_log(NULL, AV_LOG_ERROR, "Rejected: zsv_profile must be exactly 2.\n");
+            return AVERROR_INVALIDDATA;
+        }
+    }
+    if (profile_entries != 1) {
+        av_log(NULL, AV_LOG_ERROR, "Rejected: exactly one zsv_profile=2 metadata entry is required.\n");
+        return AVERROR_INVALIDDATA;
+    }
+    if (ic->nb_streams != 2) {
+        av_log(NULL, AV_LOG_ERROR, "Rejected: ZSV2 requires exactly two streams.\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    for (i = 0; i < ic->nb_streams; i++) {
+        AVCodecParameters *par = ic->streams[i]->codecpar;
+
+        if (par->codec_type == AVMEDIA_TYPE_VIDEO &&
+            par->codec_id == AV_CODEC_ID_ZSX_DCT_VIDEO &&
+            par->codec_tag == MKTAG('Z', 'S', 'X', 'D') &&
+            par->extradata_size == 16 && par->extradata &&
+            !memcmp(par->extradata, dct_prefix, sizeof(dct_prefix)) &&
+            par->extradata[6] >= 1 && par->extradata[6] <= 100 &&
+            !par->extradata[7] &&
+            AV_RL32(par->extradata + 8) == (unsigned int)par->width &&
+            AV_RL32(par->extradata + 12) == (unsigned int)par->height) {
+            video_entries++;
+        } else if (par->codec_type == AVMEDIA_TYPE_AUDIO &&
+                   par->codec_id == AV_CODEC_ID_ZSX_MDCT_AUDIO &&
+                   par->codec_tag == MKTAG('Z', 'S', 'X', 'M') &&
+                   par->extradata_size == 16 && par->extradata &&
+                   !memcmp(par->extradata, mdct_prefix, sizeof(mdct_prefix)) &&
+                   (par->extradata[6] == AV_CHANNEL_ORDER_UNSPEC ||
+                    par->extradata[6] == AV_CHANNEL_ORDER_NATIVE) &&
+                   par->extradata[7] >= 1 && par->extradata[7] <= 2 &&
+                   ((par->extradata[6] == AV_CHANNEL_ORDER_UNSPEC &&
+                     !AV_RL64(par->extradata + 8)) ||
+                    (par->extradata[6] == AV_CHANNEL_ORDER_NATIVE &&
+                     av_popcount64(AV_RL64(par->extradata + 8)) ==
+                     par->extradata[7]))) {
+            audio_entries++;
+        } else {
+            av_log(NULL, AV_LOG_ERROR,
+                   "Rejected: stream %u is not a supported ZSV2 DCT/MDCT stream.\n", i);
+            return AVERROR_INVALIDDATA;
+        }
+    }
+    if (video_entries != 1 || audio_entries != 1) {
+        av_log(NULL, AV_LOG_ERROR,
+               "Rejected: ZSV2 requires one ZSX DCT video and one ZSX MDCT audio stream.\n");
+        return AVERROR_INVALIDDATA;
+    }
+    return 0;
+}
+
+static void zsv_fail_decode(AVCodecContext *avctx, const char *operation,
+                            int error)
+{
+    SDL_Event event = { 0 };
+
+    exit_status = 1;
+    av_log(avctx, AV_LOG_ERROR, "ZSV2 decoder %s failed: %s\n",
+           operation, av_err2str(error));
+    event.type = SDL_USEREVENT + 2;
+    SDL_PushEvent(&event);
+}
