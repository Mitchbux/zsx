+/*
+ * This player is intentionally not a general-purpose ffplay build.  The
+ * suffix check is a user-facing first gate only; the demuxer, codec tags,
+ * extradata versions, stream count, and container metadata are all checked
+ * after probing below.
+ */
+static int zsv_validate_filename(const char *filename)
+{
+    const char *colon;
+    size_t length;
+
+    if (!filename)
+        return AVERROR(EINVAL);
+    length = strlen(filename);
+    if (length < 4 || av_strcasecmp(filename + length - 4, ".zsv")) {
+        av_log(NULL, AV_LOG_ERROR, "ZSV player only accepts local .zsv files.\n");
+        return AVERROR(EINVAL);
+    }
+
+    colon = strchr(filename, ':');
+    if ((filename[0] == '\\' || filename[0] == '/') &&
+        (filename[1] == '\\' || filename[1] == '/')) {
+        av_log(NULL, AV_LOG_ERROR, "ZSV player rejects UNC and device paths.\n");
+        return AVERROR(EINVAL);
+    }
+    if (!colon)
+        return 0; /* ordinary local path */
+    if (colon == filename + 1 &&
+        ((filename[0] >= 'A' && filename[0] <= 'Z') ||
+         (filename[0] >= 'a' && filename[0] <= 'z')) &&
+        (filename[2] == '\\' || filename[2] == '/'))
+        return 0; /* Windows drive path */
+    if (!av_strncasecmp(filename, "file:", 5) && filename[5] &&
+        filename[5] != '/' && filename[5] != '\\')
+        return 0; /* explicit local file protocol, without an authority */
+
+    av_log(NULL, AV_LOG_ERROR, "ZSV player only accepts the local file protocol.\n");
+    return AVERROR(EINVAL);
+}
